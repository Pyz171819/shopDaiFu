    </update>

    <delete id="deleteBizUsersById" parameterType="Long">
        update  biz_users set del_flag = '2' where id = #{id}
    </delete>

    <delete id="deleteBizUsersByIds" parameterType="String">
        update  biz_users set del_flag = '2' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deleteBizUsersBySysUserId" parameterType="Long">
        update  biz_users set del_flag = '2' where sys_user_id = #{userId}
    </delete>


</mapper>