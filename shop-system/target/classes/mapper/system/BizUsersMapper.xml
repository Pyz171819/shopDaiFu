<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shop.system.mapper.BizUsersMapper">

    <resultMap type="BizUsers" id="BizUsersResult">
        <result property="id"    column="id"    />
        <result property="sysUserId"    column="sys_user_id"    />
        <result property="avatar"    column="avatar"    />
        <result property="regIp"    column="reg_ip"    />
        <result property="commissionRate"    column="commission_rate"    />
        <result property="balance"    column="balance"    />
        <result property="payCode"    column="pay_code"    />
        <result property="permPayment"    column="perm_payment"    />
        <result property="payConfig"    column="pay_config"    />
        <result property="pid"    column="pid"    />
        <result property="agentRate"    column="agent_rate"    />
        <result property="permAddProduct"    column="perm_add_product"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="delFlag"    column="del_flag"    />
    </resultMap>

    <sql id="selectBizUsersVo">
        select id, sys_user_id, avatar, reg_ip, commission_rate, balance, pay_code, perm_payment, pay_config, pid, agent_rate, perm_add_product, create_by, create_time, update_by, update_time, del_flag from biz_users
    </sql>

    <select id="selectBizUsersList" parameterType="BizUsers" resultMap="BizUsersResult">
        <include refid="selectBizUsersVo"/>
        <where>
            del_flag = '0'
            <if test="sysUserId != null "> and sys_user_id = #{sysUserId}</if>
            <if test="avatar != null  and avatar != ''"> and avatar = #{avatar}</if>
            <if test="regIp != null  and regIp != ''"> and reg_ip = #{regIp}</if>
            <if test="commissionRate != null "> and commission_rate = #{commissionRate}</if>
            <if test="balance != null "> and balance = #{balance}</if>
            <if test="payCode != null  and payCode != ''"> and pay_code = #{payCode}</if>
            <if test="permPayment != null  and permPayment != ''"> and perm_payment = #{permPayment}</if>
            <if test="payConfig != null  and payConfig != ''"> and pay_config = #{payConfig}</if>
            <if test="pid != null "> and pid = #{pid}</if>
            <if test="agentRate != null "> and agent_rate = #{agentRate}</if>
            <if test="permAddProduct != null  and permAddProduct != ''"> and perm_add_product = #{permAddProduct}</if>
        </where>
    </select>

    <select id="selectBizUsersById" parameterType="Long" resultMap="BizUsersResult">
        <include refid="selectBizUsersVo"/>
        where id = #{id}
    </select>

    <insert id="insertBizUsers" parameterType="BizUsers" useGeneratedKeys="true" keyProperty="id">
        insert into biz_users
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="sysUserId != null">sys_user_id,</if>
            <if test="avatar != null">avatar,</if>
            <if test="regIp != null">reg_ip,</if>
            <if test="commissionRate != null">commission_rate,</if>
            <if test="balance != null">balance,</if>
            <if test="payCode != null">pay_code,</if>
            <if test="permPayment != null">perm_payment,</if>
            <if test="payConfig != null">pay_config,</if>
            <if test="pid != null">pid,</if>
            <if test="agentRate != null">agent_rate,</if>
            <if test="permAddProduct != null">perm_add_product,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="delFlag != null">del_flag,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="sysUserId != null">#{sysUserId},</if>
            <if test="avatar != null">#{avatar},</if>
            <if test="regIp != null">#{regIp},</if>
            <if test="commissionRate != null">#{commissionRate},</if>
            <if test="balance != null">#{balance},</if>
            <if test="payCode != null">#{payCode},</if>
            <if test="permPayment != null">#{permPayment},</if>
            <if test="payConfig != null">#{payConfig},</if>
            <if test="pid != null">#{pid},</if>
            <if test="agentRate != null">#{agentRate},</if>
            <if test="permAddProduct != null">#{permAddProduct},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="delFlag != null">#{delFlag},</if>
        </trim>
    </insert>

    <update id="updateBizUsers" parameterType="BizUsers">
        update biz_users
        <trim prefix="SET" suffixOverrides=",">
            <if test="sysUserId != null">sys_user_id = #{sysUserId},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
            <if test="regIp != null">reg_ip = #{regIp},</if>
            <if test="commissionRate != null">commission_rate = #{commissionRate},</if>
            <if test="balance != null">balance = #{balance},</if>
            <if test="payCode != null">pay_code = #{payCode},</if>
            <if test="permPayment != null">perm_payment = #{permPayment},</if>
            <if test="payConfig != null">pay_config = #{payConfig},</if>
            <if test="pid != null">pid = #{pid},</if>
            <if test="agentRate != null">agent_rate = #{agentRate},</if>
            <if test="permAddProduct != null">perm_add_product = #{permAddProduct},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
        </trim>
        where id = #{id}
    </update>

    <update id="updateBizUsersByUserId" parameterType="BizUsers">
        update biz_users
        <trim prefix="SET" suffixOverrides=",">
            <if test="avatar != null">avatar = #{avatar},</if>
            <if test="regIp != null">reg_ip = #{regIp},</if>
            <if test="commissionRate != null">commission_rate = #{commissionRate},</if>
            <if test="balance != null">balance = #{balance},</if>
            <if test="payCode != null">pay_code = #{payCode},</if>
            <if test="permPayment != null">perm_payment = #{permPayment},</if>
            <if test="payConfig != null">pay_config = #{payConfig},</if>
            <if test="pid != null">pid = #{pid},</if>
            <if test="agentRate != null">agent_rate = #{agentRate},</if>
            <if test="permAddProduct != null">perm_add_product = #{permAddProduct},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
        </trim>
