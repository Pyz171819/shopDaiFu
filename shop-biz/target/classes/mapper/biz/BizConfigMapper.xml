<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shop.biz.mapper.BizConfigMapper">

    <select id="selectValueByKey" resultType="java.lang.String">
        select v
        from biz_config
        where k = #{k}
            limit 1
    </select>

    <select id="countByKey" resultType="int">
        select count(1)
        from biz_config
        where k = #{k}
    </select>

    <insert id="insertConfig">
        insert into biz_config(k, v)
        values(#{k}, #{v})
    </insert>

    <update id="updateConfigByKey">
        update biz_config
        set v = #{v}
        where k = #{k}
    </update>

</mapper>