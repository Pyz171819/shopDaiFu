<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shop.biz.mapper.BizMoneyLogMapper">
    
    <resultMap type="BizMoneyLog" id="BizMoneyLogResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="type"    column="type"    />
        <result property="money"    column="money"    />
        <result property="beforeMoney"    column="before_money"    />
        <result property="afterMoney"    column="after_money"    />
        <result property="remark"    column="remark"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="delFlag"    column="del_flag"    />
    </resultMap>

    <sql id="selectBizMoneyLogVo">
        select id, user_id, type, money, before_money, after_money, remark, create_by, create_time, update_by, update_time, del_flag from biz_money_log
    </sql>

    <select id="selectBizMoneyLogList" parameterType="BizMoneyLog" resultMap="BizMoneyLogResult">
        <include refid="selectBizMoneyLogVo"/>
        <where>
            del_flag = '0'
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="type != null  and type != ''"> and type = #{type}</if>
            <if test="money != null "> and money = #{money}</if>
            <if test="beforeMoney != null "> and before_money = #{beforeMoney}</if>
            <if test="afterMoney != null "> and after_money = #{afterMoney}</if>
        </where>
    </select>
    
    <select id="selectBizMoneyLogById" parameterType="Long" resultMap="BizMoneyLogResult">
        <include refid="selectBizMoneyLogVo"/>
        where id = #{id}
    </select>

    <insert id="insertBizMoneyLog" parameterType="BizMoneyLog" useGeneratedKeys="true" keyProperty="id">
        insert into biz_money_log
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="type != null">type,</if>
            <if test="money != null">money,</if>
            <if test="beforeMoney != null">before_money,</if>
            <if test="afterMoney != null">after_money,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="delFlag != null">del_flag,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="type != null">#{type},</if>
            <if test="money != null">#{money},</if>
            <if test="beforeMoney != null">#{beforeMoney},</if>
            <if test="afterMoney != null">#{afterMoney},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="delFlag != null">#{delFlag},</if>
         </trim>
    </insert>

    <update id="updateBizMoneyLog" parameterType="BizMoneyLog">
        update biz_money_log
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="type != null">type = #{type},</if>
            <if test="money != null">money = #{money},</if>
            <if test="beforeMoney != null">before_money = #{beforeMoney},</if>
            <if test="afterMoney != null">after_money = #{afterMoney},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteBizMoneyLogById" parameterType="Long">
        update biz_money_log set del_flag = '1' where id = #{id}
    </delete>

    <delete id="deleteBizMoneyLogByIds" parameterType="String">
        update biz_money_log set del_flag = '1' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>